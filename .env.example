# Almost — local / deploy env
# Copy to apps/mcp-server/.env and apps/web/.env.local as needed

# LLM used ONLY for near-miss explanations (scoring is deterministic)
LLM_API_KEY=
LLM_PROVIDER=openai
# openai | anthropic | bedrock | stub

# Public URL of the MCP Streamable HTTP endpoint (for Alexa+ / judges)
MCP_PUBLIC_URL=http://127.0.0.1:3100/mcp

# Optional AWS (Bedrock / AgentCore stretch — do not spend credits without HITL)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=

# Optional persistence (in-memory fixtures work without this)
DATABASE_URL=

# MCP server
MCP_PORT=3100
MCP_HOST=127.0.0.1
# Comma-separated Host allowlist (DNS-rebinding protection). Default when MCP_HOST=0.0.0.0: localhost,127.0.0.1
# ALLOWED_HOSTS=localhost,127.0.0.1,almost.example.com

# Web demo — server actions call MCP_PUBLIC_URL first, then @almost/core fallback
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_MCP_URL=http://127.0.0.1:3100/mcp
# Prefer setting MCP_PUBLIC_URL for server-side web → MCP (see above)
